<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RealEstateApp.Views.LoginPage"
             xmlns:vm="clr-namespace:RealEstateApp.ViewModels"
             Title="LoginPage"
             x:DataType="vm:LoginPageViewModel">

    <VerticalStackLayout>
        <Label Text="Login Page" FontSize="Large" HorizontalOptions="Center" Margin="0,20,0,20"/>
        
        <Label Text="Username" />
        <Entry Placeholder="Enter username" Text="{Binding Username}" />
        
        <Label Text="Password" />
        <Entry Placeholder="Enter password" IsPassword="True" Text="{Binding Password}" />

        <Label
        Text="{Binding ErrorMessage}"
        TextColor="Red" />
        
        <Button Text="Login" Command="{Binding LoginCommand}" Margin="0,20,0,0"/>
    </VerticalStackLayout>
</ContentPage>