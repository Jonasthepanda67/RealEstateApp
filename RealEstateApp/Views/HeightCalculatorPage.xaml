<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:RealEstateApp.ViewModels"
             xmlns:models="clr-namespace:RealEstateApp.Models"
             x:Class="RealEstateApp.Views.HeightCalculatorPage"
             Title="HeightCalculatorPage"
             x:DataType="vm:HeightCalculatorPageViewModel">

    <VerticalStackLayout>
        <Label FontSize="Medium"
            Text="{Binding CurrentPressure, StringFormat='Current Pressure: {0:F2} hPa'}"/>
        <Label FontSize="Medium"
            Text="{Binding CurrentAltitude, StringFormat='Current Altitude: {0:F2} m'}"/>

        <Entry Text="{Binding MeasurementLabel}"
                Placeholder="Set Measurement Label"/>
        <Button Text="Save"
                Command="{Binding SaveMeasurementCommand}"/>

        <CollectionView
            Margin="15"
            ItemsSource="{Binding MeasurementsCollection}"
            SelectionMode="None">
            
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:BarometerMeasurement">
                    <Label Padding="6" FontSize="Small" FontAttributes="Bold" HorizontalTextAlignment="Center" Text="{Binding Display}"/>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>