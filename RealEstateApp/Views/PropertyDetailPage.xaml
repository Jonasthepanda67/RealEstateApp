<ContentPage
    x:Class="RealEstateApp.Views.PropertyDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:fa="clr-namespace:FontAwesome"
    xmlns:model="clr-namespace:RealEstateApp.Models"
    xmlns:vm="clr-namespace:RealEstateApp.ViewModels"
    x:DataType="vm:PropertyDetailPageViewModel"
    Title="{Binding Property.Name}"
    BackgroundColor="{AppThemeBinding Light=#F5F6F8, Dark=#121212}">

    <ContentPage.ToolbarItems>
        <ToolbarItem
            Command="{Binding EditPropertyCommand}"
            Text="Edit" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="280,*">

        <Border
        Grid.Row="0"
        StrokeThickness="0"
        StrokeShape="RoundRectangle 0,0,0,20"
        BackgroundColor="Black">

            <CarouselView
            ItemsSource="{Binding PropertyImages}"
            Loop="False"
            HorizontalOptions="Fill"
            VerticalOptions="Fill">

                <CarouselView.ItemTemplate>
                    <DataTemplate x:DataType="model:PropertyImage">

                        <Grid
                        HorizontalOptions="Fill"
                        VerticalOptions="Fill">

                            <Image
                            Source="{Binding ImageUrl}"
                            Aspect="AspectFill"
                            HorizontalOptions="Fill"
                            VerticalOptions="Fill" />

                        </Grid>

                    </DataTemplate>
                </CarouselView.ItemTemplate>

            </CarouselView>

        </Border>


        <ScrollView Grid.Row="1">

            <VerticalStackLayout
                Padding="15,20,15,35"
                Spacing="16">

                <VerticalStackLayout Spacing="5">

                    <Label
                        FontAttributes="Bold"
                        FontSize="25"
                        Text="{Binding Property.Name}"
                        TextColor="{AppThemeBinding Light=#171717, Dark=#FFFFFF}" />

                    <HorizontalStackLayout Spacing="6">

                        <Label
                            FontSize="15"
                            Text="📍"
                            VerticalOptions="Center" />

                        <Label
                            FontSize="15"
                            LineBreakMode="WordWrap"
                            Text="{Binding Property.Address}"
                            TextColor="{AppThemeBinding Light=#666666, Dark=#BBBBBB}"
                            VerticalOptions="Center" />

                    </HorizontalStackLayout>

                </VerticalStackLayout>


                <Border
                    Padding="12"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}"
                    Stroke="{AppThemeBinding Light=#E2E4E8, Dark=#333333}"
                    StrokeThickness="1">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>

                    <Grid
                        ColumnDefinitions="*,*,*,*"
                        ColumnSpacing="5">

                        <!-- Beds -->
                        <VerticalStackLayout
                            Grid.Column="0"
                            HorizontalOptions="Center"
                            Spacing="4">

                            <Label
                                FontFamily="FA-solid"
                                FontSize="19"
                                HorizontalOptions="Center"
                                Text="{x:Static fa:IconFont.Bed}"
                                TextColor="{AppThemeBinding Light=#3F51B5, Dark=#90CAF9}" />

                            <Label
                                FontAttributes="Bold"
                                FontSize="17"
                                HorizontalOptions="Center"
                                Text="{Binding Property.Beds}" />

                            <Label
                                FontSize="11"
                                HorizontalOptions="Center"
                                Text="Beds"
                                TextColor="{AppThemeBinding Light=#777777, Dark=#AAAAAA}" />

                        </VerticalStackLayout>


                        <!-- Baths -->
                        <VerticalStackLayout
                            Grid.Column="1"
                            HorizontalOptions="Center"
                            Spacing="4">

                            <Label
                                FontFamily="FA-solid"
                                FontSize="19"
                                HorizontalOptions="Center"
                                Text="{x:Static fa:IconFont.Bath}"
                                TextColor="{AppThemeBinding Light=#3F51B5, Dark=#90CAF9}" />

                            <Label
                                FontAttributes="Bold"
                                FontSize="17"
                                HorizontalOptions="Center"
                                Text="{Binding Property.Baths}" />

                            <Label
                                FontSize="11"
                                HorizontalOptions="Center"
                                Text="Baths"
                                TextColor="{AppThemeBinding Light=#777777, Dark=#AAAAAA}" />

                        </VerticalStackLayout>


                        <!-- Parking -->
                        <VerticalStackLayout
                            Grid.Column="2"
                            HorizontalOptions="Center"
                            Spacing="4">

                            <Label
                                FontFamily="FA-solid"
                                FontSize="19"
                                HorizontalOptions="Center"
                                Text="{x:Static fa:IconFont.Parking}"
                                TextColor="{AppThemeBinding Light=#3F51B5, Dark=#90CAF9}" />

                            <Label
                                FontAttributes="Bold"
                                FontSize="17"
                                HorizontalOptions="Center"
                                Text="{Binding Property.Parking}" />

                            <Label
                                FontSize="11"
                                HorizontalOptions="Center"
                                Text="Parking"
                                TextColor="{AppThemeBinding Light=#777777, Dark=#AAAAAA}" />

                        </VerticalStackLayout>


                        <!-- Land -->
                        <VerticalStackLayout
                            Grid.Column="3"
                            HorizontalOptions="Center"
                            Spacing="4">

                            <Label
                                FontSize="18"
                                HorizontalOptions="Center"
                                Text="㎡"
                                TextColor="{AppThemeBinding Light=#3F51B5, Dark=#90CAF9}" />

                            <Label
                                FontAttributes="Bold"
                                FontSize="17"
                                HorizontalOptions="Center"
                                Text="{Binding Property.LandSize}" />

                            <Label
                                FontSize="11"
                                HorizontalOptions="Center"
                                Text="Land Size"
                                TextColor="{AppThemeBinding Light=#777777, Dark=#AAAAAA}" />

                        </VerticalStackLayout>

                    </Grid>

                </Border>


                <Grid
                    ColumnDefinitions="*,*"
                    ColumnSpacing="10">

                    <Border
                        Grid.Column="0"
                        Padding="13"
                        BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}"
                        Stroke="{AppThemeBinding Light=#E2E4E8, Dark=#333333}"
                        StrokeThickness="1">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>

                        <VerticalStackLayout Spacing="3">

                            <Label
                                FontSize="10"
                                Text="PROPERTY TYPE"
                                TextColor="{AppThemeBinding Light=#777777, Dark=#AAAAAA}" />

                            <Label
                                FontAttributes="Bold"
                                FontSize="16"
                                Text="{Binding Property.Type}" />

                        </VerticalStackLayout>

                    </Border>


                    <Border
                        Grid.Column="1"
                        Padding="13"
                        BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}"
                        Stroke="{AppThemeBinding Light=#E2E4E8, Dark=#333333}"
                        StrokeThickness="1">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>

                        <VerticalStackLayout Spacing="3">

                            <Label
                                FontSize="10"
                                Text="PROPERTY TIER"
                                TextColor="{AppThemeBinding Light=#777777, Dark=#AAAAAA}" />

                            <Label
                                FontAttributes="Bold"
                                FontSize="16"
                                Text="{Binding Property.Tier}" />

                        </VerticalStackLayout>

                    </Border>

                </Grid>


                <Border
                    Padding="15"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}"
                    Stroke="{AppThemeBinding Light=#E2E4E8, Dark=#333333}"
                    StrokeThickness="1">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="10">

                        <Grid ColumnDefinitions="*,Auto">

                            <Label
                                FontAttributes="Bold"
                                FontSize="19"
                                Text="Description"
                                VerticalOptions="Center" />

                            <HorizontalStackLayout
                                Grid.Column="1"
                                Spacing="5">

                                <Button
                                    Command="{Binding TTSStartCommand}"
                                    FontFamily="FA-solid"
                                    FontSize="13"
                                    Padding="10,5"
                                    Text="{x:Static fa:IconFont.Play}"
                                    IsVisible="{Binding TTSIsNotPlaying}" />

                                <Button
                                    Command="{Binding TTSStopCommand}"
                                    FontFamily="FA-solid"
                                    FontSize="13"
                                    Padding="10,5"
                                    Text="{x:Static fa:IconFont.Stop}"
                                    IsVisible="{Binding TTSIsPlaying}" />

                            </HorizontalStackLayout>

                        </Grid>

                        <Label
                            FontSize="14"
                            LineBreakMode="WordWrap"
                            LineHeight="1.3"
                            Text="{Binding Property.Description}"
                            TextColor="{AppThemeBinding Light=#444444, Dark=#CCCCCC}" />

                    </VerticalStackLayout>

                </Border>


                <Label
                    FontAttributes="Bold"
                    FontSize="19"
                    Margin="0,5,0,0"
                    Text="Property Links" />

                <Grid
                    ColumnDefinitions="*,*"
                    ColumnSpacing="10">

                    <Button
                        Grid.Column="0"
                        Command="{Binding OpenBrowserCommand}"
                        ImageSource="link_2.png"
                        Text="Neighborhood"
                        FontSize="13"
                        Padding="5,10"
                        HorizontalOptions="Fill"
                        VerticalOptions="Fill" />

                    <Button
                        Grid.Column="1"
                        Command="{Binding OpenContractCommand}"
                        ImageSource="file_open.png"
                        Text="Contract"
                        FontSize="13"
                        Padding="5,10"
                        HorizontalOptions="Fill"
                        VerticalOptions="Fill" />

                </Grid>



                <Label
                    FontAttributes="Bold"
                    FontSize="19"
                    Margin="0,5,0,0"
                    Text="Share" />

                <Border
                    Padding="10"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}"
                    Stroke="{AppThemeBinding Light=#E2E4E8, Dark=#333333}"
                    StrokeThickness="1">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>

                    <Grid
                        ColumnDefinitions="*,*,*"
                        ColumnSpacing="5">

                        <Button
                            Grid.Column="0"
                            Command="{Binding ShareTextCommand}"
                            ImageSource="share.png"
                            Text="Share"
                            FontSize="12"
                            Padding="3,10"
                            HorizontalOptions="Fill" />

                        <Button
                            Grid.Column="1"
                            Command="{Binding ShareContractCommand}"
                            ImageSource="file_export.png"
                            Text="File"
                            FontSize="12"
                            Padding="3,10"
                            HorizontalOptions="Fill" />

                        <Button
                            Grid.Column="2"
                            Command="{Binding CopyToClipboardCommand}"
                            ImageSource="clipboard_paste.png"
                            Text="Copy"
                            FontSize="12"
                            Padding="3,10"
                            HorizontalOptions="Fill" />

                    </Grid>


                </Border>


                <Label
                    FontAttributes="Bold"
                    FontSize="19"
                    Margin="0,5,0,0"
                    Text="Location" />

                <Border
                    Padding="15"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}"
                    Stroke="{AppThemeBinding Light=#E2E4E8, Dark=#333333}"
                    StrokeThickness="1">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="7">

                        <Label
                            FontAttributes="Bold"
                            FontSize="15"
                            Text="{Binding Property.Address}" />

                        <Label
                            FontSize="12"
                            Text="{Binding Property.Latitude, StringFormat='Latitude: {0}'}"
                            TextColor="{AppThemeBinding Light=#777777, Dark=#AAAAAA}" />

                        <Label
                            FontSize="12"
                            Text="{Binding Property.Longitude, StringFormat='Longitude: {0}'}"
                            TextColor="{AppThemeBinding Light=#777777, Dark=#AAAAAA}" />

                        <Grid
                            ColumnDefinitions="*,*"
                            ColumnSpacing="10"
                            Margin="0,7,0,0">

                            <Button
                                Grid.Column="0"
                                Command="{Binding OpenMapMarkedCommand}"
                                ImageSource="map.png"
                                Text="View Map" />

                            <Button
                                Grid.Column="1"
                                Command="{Binding OpenMapDirectionsCommand}"
                                ImageSource="directions.png"
                                Text="Directions" />

                        </Grid>

                    </VerticalStackLayout>

                </Border>


                <Label
                    FontAttributes="Bold"
                    FontSize="19"
                    Margin="0,5,0,0"
                    Text="Vendor" />

                <Border
                    Padding="15"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}"
                    Stroke="{AppThemeBinding Light=#E2E4E8, Dark=#333333}"
                    StrokeThickness="1">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="8">

                        <Label
                            FontAttributes="Bold"
                            FontSize="18"
                            Text="{Binding Property.Vendor.FullName}" />

                        <HorizontalStackLayout Spacing="8">

                            <Label
                                FontFamily="FA-solid"
                                Text="{x:Static fa:IconFont.Envelope}"
                                TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}" />

                            <Label
                                FontSize="14"
                                Text="{Binding Property.Vendor.Email}"
                                TextColor="{AppThemeBinding Light=#555555, Dark=#CCCCCC}" />

                        </HorizontalStackLayout>

                        <HorizontalStackLayout Spacing="8">

                            <Label
                                FontFamily="FA-solid"
                                Text="{x:Static fa:IconFont.Phone}"
                                TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}" />

                            <Label
                                FontSize="14"
                                Text="{Binding Property.Vendor.Phone}"
                                TextColor="{AppThemeBinding Light=#555555, Dark=#CCCCCC}" />

                        </HorizontalStackLayout>

                    </VerticalStackLayout>

                </Border>


                <Label
                    FontAttributes="Bold"
                    FontSize="19"
                    Margin="0,5,0,0"
                    Text="Listed By" />

                <Border
                    Padding="15"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}"
                    Stroke="{AppThemeBinding Light=#E2E4E8, Dark=#333333}"
                    StrokeThickness="1">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>

                    <Grid
                        ColumnDefinitions="90,*"
                        ColumnSpacing="15">

                        <Border
                            Grid.Column="0"
                            HeightRequest="90"
                            WidthRequest="90"
                            StrokeThickness="0">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="45" />
                            </Border.StrokeShape>

                            <Image
                                Aspect="AspectFill"
                                HeightRequest="90"
                                Source="{Binding Agent.ImageUrl}"
                                WidthRequest="90" />

                        </Border>


                        <VerticalStackLayout
                            Grid.Column="1"
                            Spacing="5">

                            <Label
                                FontAttributes="Bold"
                                FontSize="18"
                                Text="{Binding Agent.Name}" />

                            <Label
                                FontSize="13"
                                Text="{Binding Agent.Specialization}"
                                TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}" />

                            <Label
                                FontSize="13"
                                Text="{Binding Agent.AgentType}"
                                TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}" />

                            <Label
                                FontSize="13"
                                Text="{Binding Agent.Email}"
                                TextColor="#3F51B5">

                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding OpenEmailClientCommand}"
                                        CommandParameter="{Binding Agent.Email}" />
                                </Label.GestureRecognizers>

                            </Label>

                            <Label
                                FontSize="13"
                                Text="{Binding Agent.Phone}"
                                TextColor="#3F51B5">

                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding OpenPhoneOptionsCommand}"
                                        CommandParameter="{Binding Agent.Phone}" />
                                </Label.GestureRecognizers>

                            </Label>

                        </VerticalStackLayout>

                    </Grid>

                </Border>
                

                <Label
                    FontAttributes="Bold"
                    FontSize="19"
                    Margin="0,5,0,0"
                    Text="About the Agent" />

                <Border
                    Padding="15"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}"
                    Stroke="{AppThemeBinding Light=#E2E4E8, Dark=#333333}"
                    StrokeThickness="1">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="12">

                        <Label
                            FontSize="14"
                            LineBreakMode="WordWrap"
                            LineHeight="1.3"
                            Text="{Binding Agent.Description}"
                            TextColor="{AppThemeBinding Light=#444444, Dark=#CCCCCC}" />

                        <Grid
                            ColumnDefinitions="Auto,*"
                            ColumnSpacing="10">

                            <Label
                                Grid.Column="0"
                                FontAttributes="Bold"
                                FontSize="13"
                                Text="Opening Hours:" />

                            <Label
                                Grid.Column="1"
                                FontSize="13"
                                Text="{Binding Agent.OpeningHours}"
                                TextColor="{AppThemeBinding Light=#555555, Dark=#BBBBBB}" />

                        </Grid>

                    </VerticalStackLayout>

                </Border>


                <BoxView HeightRequest="10" />

            </VerticalStackLayout>

        </ScrollView>

    </Grid>

</ContentPage>